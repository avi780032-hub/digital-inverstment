PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/invest365
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Optional: Razorpay TEST keys (dashboard.razorpay.com > Settings > API Keys, test mode). Leave empty to use the demo checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email (free with Gmail): needs a Google "App password", not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcdefghijklmnop
MAIL_FROM=Invest365 <yourname@gmail.com>

# ---- SMS: choose twilio OR fast2sms (leave SMS_PROVIDER empty to skip SMS)
SMS_PROVIDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
FAST2SMS_KEY=
